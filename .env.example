# Public site URL, for example https://mansi-store.vercel.app
SITE_URL=

# Server-only Firebase Admin service account JSON (single-line JSON)
FIREBASE_SERVICE_ACCOUNT_JSON=

# Injected automatically when the Vercel Blob store is linked to the project.
BLOB_READ_WRITE_TOKEN=

# Server-only Google service account JSON. Share the backup Sheet with this service account.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=1YPOM0mE6hBYnhco-JKhKohSkbhIVCx2abB2HKTEkmss
GOOGLE_SHEET_PRODUCTS_TAB=Products
GOOGLE_DRIVE_IMAGE_FOLDER_ID=12kpg3p3GxktybkuGqKGv6Gpe4134ri5_

# Firebase Auth emails allowed to use admin APIs, comma separated
ADMIN_EMAILS=

# Server-only AI and advertising integration credentials
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
HILLTOPADS_ANTI_ADBLOCK_KEY=

# Telegram owner alerts. Never expose these in browser JavaScript.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=
TELEGRAM_BOT_USERNAME=MansiJewellery
TELEGRAM_WEBHOOK_SECRET=

# Transactional email (Resend)
RESEND_API_KEY=
ORDER_EMAIL_FROM=Mansi Store <onboarding@resend.dev>

# Razorpay test credentials. Production keys stay unset until launch.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Vercel automatically sends this bearer secret to cron routes
CRON_SECRET=
